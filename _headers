/*
  Edge/browser caching for static assets. Dynamic HTML/API responses set their own
  cache policy in Pages Functions.
*/

/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/ads.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
